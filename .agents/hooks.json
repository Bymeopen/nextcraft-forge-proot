{
  "hermes-security-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command|write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/security_gate.py",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
