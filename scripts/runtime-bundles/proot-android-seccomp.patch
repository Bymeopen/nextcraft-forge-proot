+#if defined(ARCH_ARM64)
+/*
+ * Android's per-app seccomp filter answers every syscall outside bionic's list with SIGSYS, which kills the tracee.
+ * The kernel reports a syscall to the tracer (ptrace) before it evaluates seccomp, so a syscall that is turned into "avoid
+ * it, return -ENOSYS" here never reaches the filter. glibc, musl and the common tools all fall back cleanly on ENOSYS for
+ * these (verified against the device with scripts/runtime-bundles/sigsys-probe.c).
+ * Only relevant when seccomp acceleration is off (PROOT_NO_SECCOMP=1), because only then every syscall reaches us.
+ */
+static bool is_refused_by_android(word_t sysnum)
+{
+    switch (sysnum) {
+    case 40:  /* mount */
+    case 51:  /* chroot */
+    case 99:  /* set_robust_list */
+    case 144: /* setgid */
+    case 146: /* setuid */
+    case 159: /* setgroups */
+    case 293: /* rseq */
+    case 425: /* io_uring_setup */
+    case 426: /* io_uring_enter */
+    case 427: /* io_uring_register */
+    case 437: /* openat2 */
+    case 439: /* faccessat2 */
+    case 444: /* landlock_create_ruleset */
+    case 445: /* landlock_add_rule */
+    case 446: /* landlock_restrict_self */
+    case 449: /* futex_waitv */
+    case 452: /* fchmodat2 */
+	return true;
+    default:
+	return false;
+    }
+}
+#endif
 
