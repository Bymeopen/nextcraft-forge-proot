# Gradle & Android build outputs
.gradle/
build/
app/build/
local.properties
*.apk
*.aab
*.ap_
*.dex
*.class

# IDE & OS metadata
.idea/
*.iml
.DS_Store
Thumbs.db

# PocketDev workspace transient attachments & secrets
attachments/
.agents/.agents/
.agents/memory/history.db*
.agents/memory/forge_reference_index.db*
.git/forge_github_device.json

# Runtime bundles produced by scripts/runtime-bundles (published as release assets, not committed)
dist/

# Python bytecode (REA package and its tests)
__pycache__/
*.pyc
.pytest_cache/

# REA writes its consent marker to $HOME/.rea (tests use the repo root as HOME)
.rea/

# Native build output (CMake/Ninja)
.cxx/

# Key material (the shared debug.keystore is tracked deliberately)
*.jks
*.p12
*.pem
.kotlin/
