    "deny": [],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x /opt/nextcraft/permission-hook.sh ] && exec /opt/nextcraft/permission-hook.sh || exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
